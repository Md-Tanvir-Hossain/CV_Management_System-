{% extends 'base.html.twig' %}
{% block title %}Create account · CV Management{% endblock %}
{% block body %}
<main class="container py-5">
    <div class="mx-auto" style="max-width: 30rem;">
        <h1 class="h3 mb-4">Create account</h1>
        {{ form_start(registration_form) }}
            {{ form_row(registration_form.email) }}
            {{ form_row(registration_form.password) }}
            {{ form_row(registration_form.accountType) }}
            <button class="btn btn-primary" type="submit">Register</button>
        {{ form_end(registration_form) }}
    </div>
</main>
{% endblock %}