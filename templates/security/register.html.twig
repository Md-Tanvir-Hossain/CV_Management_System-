
{% extends 'base.html.twig' %}

{% block title %}Create Account · CV Management{% endblock %}

{% block body %}

<main class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-sm-10 col-md-7 col-lg-5">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4 p-md-5">

                    <h1 class="h3 text-center mb-2">
                        Create Account
                    </h1>

                    <p class="text-center text-secondary mb-4">
                        Create your CV Management account
                    </p>

                    {{ form_start(registration_form) }}

                        <div class="mb-3">
                            {{ form_label(registration_form.email, 'Email') }}
                            {{ form_widget(registration_form.email, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Enter your email'
                                }
                            }) }}
                            {{ form_errors(registration_form.email) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registration_form.password, 'Password') }}
                            {{ form_widget(registration_form.password, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Enter your password'
                                }
                            }) }}
                            {{ form_errors(registration_form.password) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(registration_form.accountType, 'Account Type') }}
                            {{ form_widget(registration_form.accountType, {
                                
                            }) }}
                            {{ form_errors(registration_form.accountType) }}
                        </div>

                        <button class="btn btn-primary w-100 py-2" type="submit">
                            Register
                        </button>

                    {{ form_end(registration_form) }}

                </div>

            </div>

        </div>

    </div>

</main>

{% endblock %}
