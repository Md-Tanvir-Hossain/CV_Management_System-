{% extends 'base.html.twig' %}
{% block title %}Sign in · CV Management{% endblock %}
{% block body %}
<main class="container py-5" style="max-width: 30rem;">
    <h1 class="h3 mb-4">Sign in</h1>
    {% if error %}<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
    <form method="post">
        <div class="mb-3"><label class="form-label" for="username">Email</label><input class="form-control" id="username" name="_username" type="email" value="{{ last_username }}" required autofocus></div>
        <div class="mb-3"><label class="form-label" for="password">Password</label><input class="form-control" id="password" name="_password" type="password" required></div>
        <button class="btn btn-primary" type="submit">Sign in</button>
        <a class="btn btn-link" href="{{ path('app_register') }}">Create account</a>
        <a class="btn btn-link text-secondary" href="{{ path('app_admin_user_new') }}">Create Admin account</a>
    </form>
</main>
{% endblock %}