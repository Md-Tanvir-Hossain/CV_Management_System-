{% extends 'base.html.twig' %}
{% block title %}{{ cv.position.title }} CV · CV Management{% endblock %}
{% block body %}
<main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div><p class="text-uppercase small fw-semibold text-primary mb-1">Generated CV</p><h1 class="h2 mb-1">{{ cv.position.title }}</h1><p class="text-secondary mb-0">{{ cv.candidate.email }}</p></div>
        <div class="d-flex gap-2 align-items-center"><span class="badge {{ cv.status.value == 'published' ? 'text-bg-success' : 'text-bg-warning' }}">{{ cv.status.value|title }}</span><span class="text-secondary">{{ likeCount }} likes</span></div>
    </div>
    {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}
    <section class="border rounded bg-white mb-4"><div class="p-3 border-bottom"><h2 class="h5 mb-0">Position attributes</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th class="ps-3">Attribute</th><th>Value</th><th>Type</th></tr></thead><tbody>
    {% for item in attributes %}{% set attribute = item.attribute %}{% set profileValue = item.value %}{% set currentValue = profileValue ? profileValue.value : '' %}<tr><th class="ps-3">{{ attribute.name }}</th><td class="{{ currentValue|trim == '' ? 'value-missing' : '' }}">{% if editable %}<input type="hidden" data-cv-version="{{ profileValue ? profileValue.version : 1 }}"><div data-cv-field data-update-url="{{ path('app_cv_attribute_update', {id: cv.id, attributeId: attribute.id}) }}">{% if attribute.type.value == 'text' %}<textarea class="form-control" rows="2" data-cv-value>{{ currentValue }}</textarea>{% elseif attribute.type.value == 'boolean' %}<input class="form-check-input" type="checkbox" value="true"{% if currentValue == 'true' %} checked{% endif %} data-cv-value>{% elseif attribute.type.value == 'dropdown' %}<select class="form-select" data-cv-value><option value="">Choose one</option>{% for option in attribute.options %}<option{% if currentValue == option %} selected{% endif %}>{{ option }}</option>{% endfor %}</select>{% else %}<input class="form-control" type="{% if attribute.type.value == 'numeric' %}number{% elseif attribute.type.value == 'date' %}date{% else %}text{% endif %}" value="{{ currentValue }}" data-cv-value>{% endif %}<small class="text-secondary" data-cv-save-status></small></div>{% else %}{{ currentValue ?: 'Missing' }}{% endif %}</td><td><span class="badge text-bg-light">{{ attribute.type.value }}</span></td></tr>{% else %}<tr><td colspan="3" class="text-center text-secondary py-4">This position has no selected attributes.</td></tr>{% endfor %}
    </tbody></table></div></section>
    <section class="border rounded bg-white mb-4"><div class="p-3 border-bottom"><h2 class="h5 mb-0">Relevant projects</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th class="ps-3">Project</th><th>Period</th><th>Tags</th></tr></thead><tbody>{% for project in projects %}<tr><th class="ps-3">{{ project.name }}</th><td>{{ project.periodStart ? project.periodStart|date('Y-m-d') : '—' }} – {{ project.periodEnd ? project.periodEnd|date('Y-m-d') : '—' }}</td><td>{% for tag in project.tags %}<span class="badge text-bg-light me-1">{{ tag }}</span>{% endfor %}</td></tr>{% else %}<tr><td colspan="3" class="text-center text-secondary py-4">No matching projects.</td></tr>{% endfor %}</tbody></table></div></section>
    {% if editable %}<div class="d-flex gap-2"><form method="post" action="{{ path('app_cv_publish', {id: cv.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cv-publish-' ~ cv.id) }}"><input type="hidden" name="version" value="{{ cv.version }}"><button class="btn btn-primary" type="submit"{% if missingValues %} disabled title="Fill every attribute first"{% endif %}>Publish CV</button></form><form method="post" action="{{ path('app_cv_delete', {id: cv.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cv-delete-' ~ cv.id) }}"><button class="btn btn-outline-danger" type="submit">Delete CV</button></form></div>{% elseif cv.status.value == 'published' and (is_granted('ROLE_RECRUITER') or is_granted('ROLE_ADMIN')) %}<form method="post" action="{{ path('app_cv_like', {id: cv.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cv-like-' ~ cv.id) }}"><button class="btn btn-outline-primary" type="submit">{{ liked ? 'Unlike CV' : 'Like CV' }}</button></form>{% endif %}
</main>
{% if editable %}<script>
    document.querySelectorAll('[data-cv-field]').forEach((field) => {
        const input = field.querySelector('[data-cv-value]');
        const version = field.closest('td').querySelector('[data-cv-version]');
        const status = field.querySelector('[data-cv-save-status]');
        input.addEventListener('change', async () => {
            const value = input.type === 'checkbox' ? (input.checked ? 'true' : 'false') : input.value;
            const response = await fetch(field.dataset.updateUrl, {method: 'PATCH', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({value, version: Number(version.value)})});
            if (response.status === 409) { status.textContent = 'Changed elsewhere. Reload this page.'; return; }
            if (!response.ok) { status.textContent = 'Could not save.'; return; }
            version.value = (await response.json()).version;
            input.closest('td').classList.toggle('value-missing', value.trim() === '');
            status.textContent = 'Saved';
        });
    });
</script>{% endif %}
{% endblock %}