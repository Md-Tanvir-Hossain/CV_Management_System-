{% extends 'base.html.twig' %}
{% block title %}Position template · CV Management{% endblock %}
{% block body %}
<main class="container py-5"><div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase small fw-semibold text-primary mb-1">M4 · Template editor</p><h1 class="h2 mb-0">{{ position.id ? 'Edit position' : 'Create position' }}</h1></div><a class="btn btn-outline-secondary" href="{{ path('app_position_index') }}">Back to positions</a></div>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('position') }}"><input type="hidden" name="version" value="{{ position.version }}"><div class="row g-4"><div class="col-lg-5"><div class="border rounded bg-white p-3 mb-4"><h2 class="h5">Position details</h2><div class="mb-3"><label class="form-label" for="title">Title</label><input class="form-control" id="title" name="title" value="{{ position.title }}" required></div><div class="mb-3"><label class="form-label" for="company">Company</label><input class="form-control" id="company" name="company" value="{{ position.company }}"></div><div class="mb-3"><label class="form-label" for="level">Level</label><select class="form-select" id="level" name="level"><option value="">Any level</option>{% for level in levels %}<option value="{{ level.value }}"{% if position.level and position.level.value == level.value %} selected{% endif %}>{{ level.value|replace({'_': ' '})|title }}</option>{% endfor %}</select></div><div class="mb-3"><label class="form-label" for="description">Short description</label><textarea class="form-control" id="description" name="short_description" rows="4">{{ position.shortDescription }}</textarea></div><div class="form-check mb-3"><input class="form-check-input" id="is-public" name="is_public" value="1" type="checkbox"{% if position.isPublic %} checked{% endif %}><label class="form-check-label" for="is-public">Public position</label></div><div class="mb-3"><label class="form-label" for="project-tags">Relevant project tags</label><input class="form-control" id="project-tags" name="project_tags" value="{{ position.projectTags|join(', ') }}" placeholder="Symfony, PostgreSQL"></div><div><label class="form-label" for="max-projects">Maximum projects</label><input class="form-control" id="max-projects" name="max_projects" type="number" min="0" value="{{ position.maxProjects }}"></div></div></div>
<div class="col-lg-7"><div class="border rounded bg-white p-3"><h2 class="h5">CV attributes and access rules</h2><p class="small text-secondary">Select attributes to include in generated CVs. Enable a rule only when candidates must satisfy it. Multiple rules are combined with AND.</p><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Include</th><th>Attribute</th><th>Access rule</th><th>Comparison</th></tr></thead><tbody>{% for attribute in attributes %}{% set id = attribute.id %}{% set rule = rules[id] ?? {} %}<tr><td><input class="form-check-input" name="attributes[]" value="{{ id }}" type="checkbox"{% if id in selectedIds %} checked{% endif %}></td><th>{{ attribute.name }}<small class="d-block text-secondary">{{ attribute.type.value }}</small></th><td><select class="form-select form-select-sm" name="rules[{{ id }}][operator]"><option value="">No rule</option>{% for operator in operators[id] %}<option value="{{ operator.value }}"{% if rule.operator|default('') == operator.value %} selected{% endif %}>{{ operator.value|replace({'_': ' '})|title }}</option>{% endfor %}</select><input type="hidden" name="rules[{{ id }}][enabled]" value="1"></td><td><input class="form-control form-control-sm" name="rules[{{ id }}][value]" value="{{ rule.value|default('') }}" placeholder="Required value"></td></tr>{% endfor %}</tbody></table></div><button class="btn btn-primary" type="submit">Save position</button></div></div></div></form></main>
{% endblock %}