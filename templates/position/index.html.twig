{% extends 'base.html.twig' %}
{% block title %}Positions · CV Management{% endblock %}
{% block body %}
<main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h2 mb-0">Positions</h1></div>{% if canManage %}<a class="btn btn-primary" href="{{ path('app_position_new') }}">Add position</a>{% endif %}</div>
    {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}
    <form class="row g-2 align-items-end mb-4" method="get"><div class="col-md-9"><label class="form-label" for="position-search">Search positions</label><input class="form-control" id="position-search" name="q" value="{{ query }}" placeholder="Title or company"></div><div class="col-md-3 d-grid"><button class="btn btn-outline-primary" type="submit">Search</button></div></form>
    <form method="post" id="position-actions"><input type="hidden" name="_token" data-position-token><div class="d-flex align-items-center gap-2 mb-2" data-position-toolbar hidden><span class="small text-secondary" data-position-count>0 selected</span>{% if canManage %}<button class="btn btn-sm btn-outline-secondary" type="button" data-position-edit disabled>Edit selected</button><button class="btn btn-sm btn-outline-secondary" type="submit" data-position-duplicate disabled>Duplicate selected</button><button class="btn btn-sm btn-outline-danger" type="submit" data-position-delete disabled>Delete selected</button>{% endif %}</div>
    <div class="table-responsive border rounded bg-white"><table class="table table-hover align-middle mb-0"><thead><tr><th class="ps-3">{% if canManage %}<span class="visually-hidden">Select</span>{% endif %}</th><th>Title</th><th>Company</th><th>Level</th><th>Visibility</th><th>Updated</th><th>CVs</th></tr></thead><tbody>{% for position in positions %}<tr><td class="ps-3">{% if canManage %}<input class="form-check-input" type="checkbox" data-position-id="{{ position.id }}" data-position-token="{{ csrf_token('duplicate-position-' ~ position.id) }}" data-position-delete-token="{{ csrf_token('delete-position-' ~ position.id) }}" aria-label="Select {{ position.title }}">{% endif %}</td><th><a href="{{ path('app_position_discussion', {id: position.id}) }}">{{ position.title }}</a></th><td>{{ position.company ?: '—' }}</td><td>{{ position.level ? position.level.value|replace({'_': ' '})|title : '—' }}</td><td>{% if position.isPublic %}<span class="badge text-bg-success">Public</span>{% else %}<span class="badge text-bg-secondary">Restricted</span>{% endif %}</td><td>{{ position.updatedAt|date('Y-m-d H:i') }}</td><td>{% if canManage %}<a href="{{ path('app_position_cvs', {id: position.id}) }}">View published CVs</a>{% else %}—{% endif %}</td></tr>{% else %}<tr><td colspan="7" class="text-center text-secondary py-5">No positions found.</td></tr>{% endfor %}</tbody></table></div></form>
</main>
{% if canManage %}<script>
const toolbar = document.querySelector('[data-position-toolbar]'); const count = document.querySelector('[data-position-count]'); const edit = document.querySelector('[data-position-edit]'); const duplicate = document.querySelector('[data-position-duplicate]'); const remove = document.querySelector('[data-position-delete]'); const checks = [...document.querySelectorAll('[data-position-id]')];
const update = () => { const selected = checks.filter((item) => item.checked); toolbar.hidden = selected.length === 0; count.textContent = `${selected.length} selected`; edit.disabled = duplicate.disabled = remove.disabled = selected.length !== 1; if (selected.length === 1) { edit.onclick = () => window.location.href = `/positions/${selected[0].dataset.positionId}/edit`; duplicate.formAction = `/positions/${selected[0].dataset.positionId}/duplicate`; remove.formAction = `/positions/${selected[0].dataset.positionId}/delete`; duplicate.onclick = () => document.querySelector('[data-position-token]').value = selected[0].dataset.positionToken; remove.onclick = () => document.querySelector('[data-position-token]').value = selected[0].dataset.positionDeleteToken; } }; checks.forEach((item) => item.addEventListener('change', update));
</script>{% endif %}
{% endblock %}