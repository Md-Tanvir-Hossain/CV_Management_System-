{% extends 'base.html.twig' %}
{% set activeTab = app.request.query.get('tab', 'me') %}
{% block title %}My Profile · CV Management{% endblock %}
{% block body %}
<main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><p class="text-uppercase small fw-semibold text-primary mb-1">Candidate workspace</p><h1 class="h2 mb-0">My Profile</h1></div>
        <span class="badge text-bg-light">Autosaves every 7 seconds</span>
    </div>
    {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}
    <div class="alert alert-warning d-none" data-autosave-conflict role="alert">This profile changed in another tab. Reload this page before continuing.</div>

    <ul class="nav nav-tabs mb-4">
        {% for tab, label in {'me': 'Me', 'info': 'Info', 'projects': 'Projects', 'cvs': 'CVs'} %}
            <li class="nav-item"><a class="nav-link{% if activeTab == tab %} active{% endif %}" href="{{ path('app_profile', {tab: tab}) }}">{{ label }}</a></li>
        {% endfor %}
    </ul>

    {% if activeTab == 'me' %}
        <p class="text-secondary">These built-in fields are always part of your profile and cannot be removed.</p>
        <div class="table-responsive border rounded bg-white"><table class="table align-middle mb-0"><thead><tr><th class="ps-3">Field</th><th>Value</th><th>Type</th></tr></thead><tbody>
        {% for attribute in builtInAttributes %}
            {% set profileValue = valueByAttribute[attribute.id] ?? null %}
            <tr><th class="ps-3">{{ attribute.name }}</th><td>{{ _self.value_input(attribute, profileValue) }}</td><td><span class="badge text-bg-light">{{ attribute.type.value }}</span></td></tr>
        {% endfor %}
        </tbody></table></div>
    {% elseif activeTab == 'info' %}
        <div class="row g-4">
            <div class="col-lg-8">
                <p class="text-secondary">Select reusable attributes from the shared library, then fill them here.</p>
                <div class="table-responsive border rounded bg-white"><table class="table align-middle mb-0"><thead><tr><th class="ps-3">Field</th><th>Value</th><th>Type</th><th class="text-end pe-3"><span class="visually-hidden">Select</span></th></tr></thead><tbody>
                {% for profileValue in selectedAttributes %}
                    <tr><th class="ps-3">{{ profileValue.attribute.name }}</th><td>{{ _self.value_input(profileValue.attribute, profileValue) }}</td><td><span class="badge text-bg-light">{{ profileValue.attribute.type.value }}</span></td><td class="text-end pe-3"><form method="post" action="{{ path('app_profile_attribute_remove', {id: profileValue.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('profile-attribute-remove-' ~ profileValue.id) }}"><button class="btn btn-sm btn-outline-secondary" type="submit">Remove</button></form></td></tr>
                {% else %}<tr><td colspan="4" class="text-center text-secondary py-4">No custom attributes selected.</td></tr>{% endfor %}
                </tbody></table></div>
            </div>
            <div class="col-lg-4"><div class="border rounded bg-white p-3"><h2 class="h5">Add an attribute</h2><form method="post" action="{{ path('app_profile_attribute_add') }}"><input type="hidden" name="_token" value="{{ csrf_token('profile-attribute') }}"><label class="form-label" for="profile-attribute-select">Library attribute</label><select class="form-select mb-3" id="profile-attribute-select" name="attribute_id" required><option value="">Choose one</option>{% for attribute in availableAttributes %}<option value="{{ attribute.id }}">{{ attribute.name }} · {{ attribute.category.value|title }}</option>{% endfor %}</select><button class="btn btn-primary" type="submit">Add to profile</button></form></div></div>
        </div>
    {% elseif activeTab == 'projects' %}
        <div class="d-flex justify-content-between align-items-center mb-3"><p class="text-secondary mb-0">Use Markdown in descriptions and comma-separated technology tags.</p><a class="btn btn-primary" href="{{ path('app_project_new') }}">Add project</a></div>
        <form method="post" id="project-actions"><div class="d-flex align-items-center gap-2 mb-2" data-project-toolbar hidden><span class="small text-secondary" data-project-count>0 selected</span><button class="btn btn-sm btn-outline-secondary" type="button" data-project-edit disabled>Edit selected</button><button class="btn btn-sm btn-outline-danger" type="submit" data-project-delete disabled>Delete selected</button></div>
        <div class="table-responsive border rounded bg-white"><table class="table table-hover align-middle mb-0"><thead><tr><th class="ps-3"></th><th>Name</th><th>Period</th><th>Tags</th></tr></thead><tbody>{% for project in projects %}<tr><td class="ps-3"><input class="form-check-input" type="checkbox" data-project-id="{{ project.id }}" data-project-version="{{ project.version }}" aria-label="Select {{ project.name }}"></td><th>{{ project.name }}</th><td>{{ project.periodStart ? project.periodStart|date('Y-m-d') : '—' }} – {{ project.periodEnd ? project.periodEnd|date('Y-m-d') : '—' }}</td><td>{% for tag in project.tags %}<span class="badge text-bg-light me-1">{{ tag }}</span>{% endfor %}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-secondary py-5">No projects yet.</td></tr>{% endfor %}</tbody></table></div></form>
    {% else %}
        <p class="text-secondary">Your generated CVs will appear here. CV creation and generation are implemented in M5.</p>
        <div class="table-responsive border rounded bg-white"><table class="table align-middle mb-0"><thead><tr><th class="ps-3">Position</th><th>Status</th><th>Updated</th></tr></thead><tbody><tr><td colspan="3" class="text-center text-secondary py-5">No CVs created yet.</td></tr></tbody></table></div>
    {% endif %}
</main>
{% macro value_input(attribute, profileValue) %}
    {% set currentValue = profileValue ? profileValue.value : '' %}
    {% if profileValue %}<input type="hidden" data-profile-version="{{ profileValue.version }}">{% endif %}
    {% if attribute.type.value == 'text' %}<textarea class="form-control" rows="2" data-autosave-url="{{ profileValue ? path('app_profile_attribute_autosave', {id: profileValue.id}) : '' }}" data-autosave-value>{{ currentValue }}</textarea>
    {% elseif attribute.type.value == 'boolean' %}<input class="form-check-input" type="checkbox" value="true"{% if currentValue == 'true' %} checked{% endif %} data-autosave-url="{{ profileValue ? path('app_profile_attribute_autosave', {id: profileValue.id}) : '' }}" data-autosave-value>
    {% elseif attribute.type.value == 'dropdown' %}<select class="form-select" data-autosave-url="{{ profileValue ? path('app_profile_attribute_autosave', {id: profileValue.id}) : '' }}" data-autosave-value><option value="">Choose one</option>{% for option in attribute.options %}<option{% if currentValue == option %} selected{% endif %}>{{ option }}</option>{% endfor %}</select>
    {% else %}<input class="form-control" type="{% if attribute.type.value == 'numeric' %}number{% elseif attribute.type.value == 'date' %}date{% else %}text{% endif %}" value="{{ currentValue }}" data-autosave-url="{{ profileValue ? path('app_profile_attribute_autosave', {id: profileValue.id}) : '' }}" data-autosave-value>{% endif %}
{% endmacro %}
{% block javascripts %}{{ parent() }}<script>
    const autosaveFields = [...document.querySelectorAll('[data-autosave-value][data-autosave-url]')];
    const conflict = document.querySelector('[data-autosave-conflict]');
    const dirty = new Set();
    autosaveFields.forEach((field) => field.addEventListener('input', () => dirty.add(field)));
    autosaveFields.forEach((field) => field.addEventListener('change', () => dirty.add(field)));
    const saveField = async (field) => {
        const versionElement = field.closest('td')?.querySelector('[data-profile-version]') || field.previousElementSibling;
        const value = field.type === 'checkbox' ? (field.checked ? 'true' : 'false') : field.value;
        const response = await fetch(field.dataset.autosaveUrl, {method: 'PATCH', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({value, version: Number(versionElement?.value || versionElement?.dataset.profileVersion || 1)})});
        if (response.status === 409) { conflict.classList.remove('d-none'); return; }
        if (!response.ok) return;
        const data = await response.json();
        if (versionElement) { versionElement.value = data.version; versionElement.dataset.profileVersion = data.version; }
        dirty.delete(field);
    };
    setInterval(() => [...dirty].forEach(saveField), 7000);

    const projectToolbar = document.querySelector('[data-project-toolbar]');
    if (projectToolbar) {
        const projectChecks = [...document.querySelectorAll('[data-project-id]')];
        const updateProjects = () => { const selected = projectChecks.filter((item) => item.checked); projectToolbar.hidden = selected.length === 0; projectToolbar.querySelector('[data-project-count]').textContent = `${selected.length} selected`; const edit = projectToolbar.querySelector('[data-project-edit]'); const remove = projectToolbar.querySelector('[data-project-delete]'); edit.disabled = remove.disabled = selected.length !== 1; if (selected.length === 1) { edit.onclick = () => window.location.href = `/profile/projects/${selected[0].dataset.projectId}/edit`; remove.formAction = `/profile/projects/${selected[0].dataset.projectId}/delete`; } };
        projectChecks.forEach((item) => item.addEventListener('change', updateProjects));
    }
</script>{% endblock %}
{% endblock %}