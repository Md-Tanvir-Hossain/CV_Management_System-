{% extends 'base.html.twig' %}
{% block title %}{{ heading }} · CV Management{% endblock %}
{% block body %}<main class="container py-5" style="max-width: 52rem;"><div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2 mb-0">{{ heading }}</h1><a class="btn btn-outline-secondary" href="{{ path('app_profile', {tab: 'projects'}) }}">Back to projects</a></div><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('project') }}"><input type="hidden" name="version" value="{{ project.version }}"><div class="mb-3"><label class="form-label" for="project-name">Name</label><input class="form-control" id="project-name" name="name" value="{{ project.name }}" required></div><div class="row g-3 mb-3"><div class="col-sm-6"><label class="form-label" for="project-start">Period start</label><input class="form-control" id="project-start" name="period_start" type="date" value="{{ project.periodStart ? project.periodStart|date('Y-m-d') : '' }}"></div><div class="col-sm-6"><label class="form-label" for="project-end">Period end</label><input class="form-control" id="project-end" name="period_end" type="date" value="{{ project.periodEnd ? project.periodEnd|date('Y-m-d') : '' }}"></div></div><div class="mb-3"><label class="form-label" for="project-tags">Technology tags</label><input class="form-control" id="project-tags" name="tags" list="known-project-tags" value="{{ project.tags|join(', ') }}" placeholder="Symfony, PostgreSQL"><datalist id="known-project-tags">{% for tag in knownTags %}<option value="{{ tag }}">{% endfor %}</datalist></div><div class="mb-4"><label class="form-label" for="project-description">Description (Markdown)</label><textarea class="form-control" id="project-description" name="description" rows="8">{{ project.description }}</textarea></div><button class="btn btn-primary" type="submit">Save project</button></form></main>{% endblock %}